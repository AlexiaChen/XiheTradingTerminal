{
  "name": "tradingview",
  "displayName": "TradingView Sidebar",
  "description": "TradingView charts in the VS Code sidebar with tabbed layouts, indicator presets, and collapsible controls.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.108.1"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "tradingview",
    "chart",
    "crypto",
    "stocks",
    "technical-analysis",
    "sidebar"
  ],
  "activationEvents": [
    "onView:tradingview.sidebar",
    "onCommand:tradingview.reload"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tradingview",
          "title": "TradingView",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "tradingview": [
        {
          "id": "tradingview.sidebar",
          "name": "Chart",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "tradingview.reload",
        "title": "Reload Sidebar",
        "category": "TradingView"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.108.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.52.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
