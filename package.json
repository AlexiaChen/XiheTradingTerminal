{
  "name": "xihe-trading-terminal",
  "displayName": "XiheTradingTerminal",
  "description": "A personal Gruvbox chart terminal for VS Code, with named workspaces, persistent chart tabs, ZigZag and MA presets.",
  "version": "0.0.2",
  "publisher": "AlexiaChen",
  "repository": "https://github.com/AlexiaChen/XiheTradingTerminal.git",
  "engines": {
    "vscode": "^1.108.1",
    "node": ">=24"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "xihe",
    "trading-terminal",
    "gruvbox",
    "tradingview",
    "chart",
    "crypto",
    "stocks",
    "technical-analysis"
  ],
  "activationEvents": [
    "onView:xihe-trading-terminal.sidebar",
    "onCommand:xihe-trading-terminal.reload"
  ],
  "icon": "media/xihe.png",
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "xihe-trading-terminal",
          "title": "XiheTradingTerminal",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "xihe-trading-terminal": [
        {
          "id": "xihe-trading-terminal.sidebar",
          "name": "Chart Workspace",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "xihe-trading-terminal.reload",
        "title": "Reload Sidebar",
        "category": "XiheTradingTerminal"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run typecheck && vite build && vite build --mode webview",
    "compile": "npm run build",
    "watch": "node scripts/watch.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run lint && npm run build",
    "test": "vitest run",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/vscode": "1.108.1",
    "@vscode/vsce": "4.1.0",
    "eslint": "10.13.0",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
