{
  "name": "tradingview",
  "displayName": "TradingView Sidebar",
  "description": "TradingView charts in the VS Code sidebar with tabbed layouts, indicator presets, and collapsible controls.",
  "version": "0.0.2",
  "publisher": "farbodghasemlu",
  "repository": "https://github.com/farbodghasemlu/tradingview-vscode.git",
  "engines": {
    "vscode": "^1.108.1",
    "node": ">=24"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "tradingview",
    "chart",
    "crypto",
    "stocks",
    "technical-analysis",
    "sidebar"
  ],
  "activationEvents": [
    "onView:tradingview.sidebar",
    "onCommand:tradingview.reload"
  ],
  "icon": "media/tw.png",
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tradingview",
          "title": "TradingView",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "tradingview": [
        {
          "id": "tradingview.sidebar",
          "name": "Chart",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "tradingview.reload",
        "title": "Reload Sidebar",
        "category": "TradingView"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run typecheck && vite build && vite build --mode webview",
    "compile": "npm run build",
    "watch": "node scripts/watch.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run lint && npm run build",
    "test": "vitest run",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/vscode": "1.108.1",
    "@vscode/vsce": "4.1.0",
    "eslint": "10.13.0",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
